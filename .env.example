# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5007
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace
SERVER_BASE_URL=http://localhost:5007  # public URL of this API (used in upload URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001   # admin, storefront
TRUST_PROXY=1                        # number of proxies in front (nginx = 1)

# ─── Database & cache ──────────────────────────────────────────────────
DATABASE_URL=postgresql://griipbuddy:griipbuddy@localhost:5432/griipbuddy?schema=public
# Optional. Enables shared rate limits + the BullMQ job queue. Leave empty to run without Redis.
REDIS_URL=redis://localhost:6379

# Production docker-compose.yml only (Postgres container credentials)
POSTGRES_USER=griipbuddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=griipbuddy

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=365d
BCRYPT_SALT_ROUNDS=12

# ─── Checkout ──────────────────────────────────────────────────────────
DELIVERY_CHARGE_INSIDE_DHAKA=80
DELIVERY_CHARGE_OUTSIDE_DHAKA=120

# ─── File storage (optional) ───────────────────────────────────────────
# Used in this order: Cloudinary → S3 → local disk (./uploads, served at /uploads).
# Uploads always return a short path ("uploads/<id>.jpg"); the frontend adds the base URL.
# Cloudinary: Dashboard → API Keys (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FILE_LOAD_BASE_URL=              # e.g. a CloudFront URL

# ─── SMS to customers (optional, BulkSMSBD): order updates + login codes ─────
# Empty → no SMS is sent. Outside production the login code is also returned
# as `dev_otp` and logged, so you can test the OTP login without SMS.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=http://bulksmsbd.net/api/smsapi

# ─── Email (optional, SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=GriipBuddy
SMTP_FROM_EMAIL=

# ─── Scheduled jobs ────────────────────────────────────────────────────
CRON_ENABLED=true
ADMIN_ALERT_EMAILS=                  # comma-separated; receives the daily low-stock email
LOW_STOCK_THRESHOLD=5
AUDIT_LOG_RETENTION_DAYS=180

# ─── Seed (first super admin; `npm run db:seed`) ───────────────────────
# SEED_ADMIN_PHONE=01700000000
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_ADMIN_NAME=Super Admin
